# --- Supabase ---
# Get these from your Supabase project settings → API.
# Until these are set, the app runs entirely on local browser storage
# seeded from lib/data/seed.ts (see README "Connecting Supabase").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data (Watchlist) ---
# Any REST/WebSocket quote provider works (e.g. Finnhub, Polygon, Twelve Data).
# Wire it up in app/api/quotes (create this route) and lib/data/seed.ts.
NEXT_PUBLIC_MARKET_DATA_API_KEY=

# --- Economic calendar (News) ---
# A provider like TradingEconomics, Finnhub, or FCS API works well.
# Wire it up in a new app/api/news route and swap seedNews() in lib/data/seed.ts.
ECONOMIC_CALENDAR_API_KEY=
